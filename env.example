# .env.example
# this file is an example to document the variables that exist in the system

# Server Configuration
ADDR=:8080
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
SHUTDOWN_TIMEOUT=30s

# Database 
DATABASE_URL=postgres://user:password@localhost:5432/webhooks?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_ADD_SOURCE=false

# Telemetry
SERVICE_NAME=webhook-delivery-system
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
OTEL_ENABLED=true
OTEL_EXPORTER_URL=http://localhost:4318

# Security
ALLOWED_ORIGINS=*
RATE_LIMIT_RPS=100

# Worker
WORKER_POOL_INTERNAL_SEC=5
WORKER_BATCH_SIZE=5 

# ==================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Update to ".env" with your actual values
# 3. NEVER commit .env to git
# ==================================================